NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# WhatsApp por código de emparejamiento (Evolution API v2, auto-hospedada).
# Si faltan, la app usa modo demo y lo dice en pantalla. No es la API oficial de Meta.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# URL pública de los links de WhatsApp (confirmación, recordatorios, cancelación, reactivación).
# Si falta, o si es un host *.vercel.app de preview/rama, el código usa la URL de producción.
# No uses VERCEL_URL ni VERCEL_BRANCH_URL.
APP_BASE_URL=https://barber-saas-chi-five.vercel.app

# Apaga el Vercel Toolbar en los deploys de preview (el ajuste del proyecto lo apaga también en producción).
VERCEL_PREVIEW_FEEDBACK_ENABLED=0

# Mensajes automáticos (ver MESSAGING.md)
CRON_SECRET=
WHATSAPP_SEND_ALLOWLIST=
WHATSAPP_FALLBACK_INSTANCE=
# Email: Brevo (prioridad, requiere EMAIL_FROM) > Resend > mock
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_SEND_ALLOWLIST=
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_KEY=

# Apple Wallet vía WalletWallet (free 1000 pases/mes). Vacío = botón oculto
WALLETWALLET_API_KEY=
